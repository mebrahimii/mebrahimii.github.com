figure figcaption {
    margin-top: -2rem;
    font-size: 0.8rem;
}

figure figcaption {
    text-align: left;
}

figure figcaption .attribution,
figure figcaption .attribution  a {
    color: #b9b3b3;
}


figure figcaption .attribution {
    float: right;
    margin-top: 0rem;
    margin-bottom: 1rem;
}

figure {
    margin: 1rem 1rem;
}

#body-inner figure figcaption .attribution a {
    font-weight: 100;
}


/* Margin before ul and ol */

p + ul,
p + ol {
    -webkit-margin-before: -0.4em;

}

div#body-inner #main {
    background-color: inherit;
}

body[data-url="/project/overview/"] table td:nth-child(5) {
    white-space: nowrap;
}
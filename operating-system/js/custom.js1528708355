jQuery(document).ready(function() {

    // Unset event handlers set in themes/hugo-theme-learn/js/learn.js

    $("#toc-menu").off('mouseenter mouseleave click');
    $(".progress").off('mouseenter mouseleave click');

    var touchsupport = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0) || (navigator.msMaxTouchPoints > 0);

    if (!touchsupport){ // browser doesn't support touch
        $("#toc-menu").mouseover(function() {
            $("#toc-wrapper").stop(true, false, true).fadeIn(100);
        });

        $("#toc-wrapper").mouseleave(function () {
            $("#toc-wrapper").stop(true, false, true).fadeOut(100);
        });
    }

    if (touchsupport){ // browser does support touch

        $('.progress').click(function() {
            $('.progress').stop(true, false, true).fadeOut(100);
        });

        $("#toc-menu").click(function() {
            $("#toc-wrapper").stop(true, false, true).fadeIn(100);
        });
    }

    // all browsers

    $("#toc-wrapper a").click(function() {
        $("#toc-wrapper").stop(true, false, true).fadeOut(200);
    });
    
    $("#toc-wrapper i").click(function () {
        $("#toc-wrapper").stop(true, false, true).fadeOut(200);
    });

    // Show the ul containing the active li element. 
    // Cannot use .show() to override css display: none !important

    $("#sidebar ul li.active").parent().attr( "style", "display: block !important;" );

    /*

